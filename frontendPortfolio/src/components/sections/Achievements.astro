---
import type { Education } from "../../lib/api/schemas";
import { formatYearMonth, padIndex } from "../../lib/format";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  readonly achievements: readonly string[];
  readonly education: readonly Education[];
}

const { achievements, education } = Astro.props;
---

<section id="achievements" class="relative px-5 py-28 sm:px-8 md:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader index={6} label="Recognition" title="Milestones" emphasis="& schooling." />

    <div class="grid gap-12 lg:grid-cols-12">
      <ol class="lg:col-span-7">
        {
          achievements.map((achievement, index) => (
            <li class="group flex gap-6 border-t border-line py-5 last:border-b" data-reveal style={`--reveal-index: ${index % 3}`}>
              <span class="tabular text-sm text-faint transition-colors group-hover:text-accent">{padIndex(index)}</span>
              <span class="text-lg leading-snug text-muted transition-colors group-hover:text-text">{achievement}</span>
            </li>
          ))
        }
      </ol>
      <div class="grid content-start gap-5 lg:col-span-5">
        {
          education.map((entry, index) => (
            <article class="card p-6" data-reveal style={`--reveal-index: ${index}`}>
              <p class="tabular text-xs text-faint">
                {formatYearMonth(entry.start_date)} — {formatYearMonth(entry.end_date)}
              </p>
              <h3 class="mt-3 text-xl font-medium">{entry.institution}</h3>
              <p class="mt-1 text-muted">
                {entry.degree} · {entry.field}
              </p>
              <p class="pill mt-5 border-accent/25 text-accent">{entry.grade}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
