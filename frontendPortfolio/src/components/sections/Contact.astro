---
import type { Professional } from "../../lib/api/schemas";
import { CONTACT_LIMITS } from "../../lib/contact/contactForm";
import { profileHandle } from "../../lib/format";

interface Props {
  readonly email: string;
  readonly name: string;
  readonly professional: Professional;
  readonly linkedinUrl: string | null;
  readonly resumeUrl: string;
}

const { email, name, professional, linkedinUrl, resumeUrl } = Astro.props;
const primaryGithub = professional.github_links[0];
const COLUMNS_LG = 4;
const COLUMNS_SM = 2;
const links = [
  ...(primaryGithub === undefined ? [] : [{ label: "GitHub", url: primaryGithub, note: profileHandle(primaryGithub) }]),
  ...(linkedinUrl === null ? [] : [{ label: "LinkedIn", url: linkedinUrl, note: profileHandle(linkedinUrl) }]),
  ...(professional.twitter_url === null
    ? []
    : [{ label: "X", url: professional.twitter_url, note: profileHandle(professional.twitter_url) }]),
  ...professional.leetcode_links.map((url) => ({ label: "LeetCode", url, note: profileHandle(url) })),
  ...professional.codeforces_links.map((url) => ({ label: "Codeforces", url, note: profileHandle(url) })),
  { label: "Résumé", url: resumeUrl, note: "PDF" },
];
const year = new Date().getUTCFullYear();

function fillLastRow(index: number): string {
  if (index !== links.length - 1) {
    return "";
  }
  const lgGap = COLUMNS_LG - (links.length % COLUMNS_LG);
  const smGap = COLUMNS_SM - (links.length % COLUMNS_SM);
  const lg = lgGap === COLUMNS_LG ? "" : `lg:col-span-${lgGap + 1}`;
  const sm = smGap === COLUMNS_SM ? "" : `sm:col-span-${smGap + 1}`;
  return `${sm} ${lg}`.trim();
}
---

<section id="contact" class="relative overflow-hidden px-5 pt-28 pb-10 sm:px-8 md:pt-40">
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[70%] bg-[radial-gradient(ellipse_at_50%_100%,rgb(245_165_36/0.16),transparent_60%)]" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl">
    <p class="eyebrow" data-reveal><span class="text-accent">08</span><span class="mx-2 text-faint">/</span>Contact</p>
    <h2 class="display mt-8 text-[clamp(3.5rem,11vw,10rem)]" data-reveal style="--reveal-index: 1">
      Let's build <em class="text-accent italic">something.</em>
    </h2>
    <div class="mt-14 grid gap-6 lg:grid-cols-12" data-reveal style="--reveal-index: 2">
      <form data-contact-form novalidate class="card relative p-6 sm:p-8 lg:col-span-7" aria-labelledby="contact-form-title">
        <h3 id="contact-form-title" class="text-xl font-medium">Send me a message</h3>
        <p class="mt-1 text-sm text-muted">It lands straight in my inbox. I reply from my own address.</p>

        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          <div class="contact-field">
            <label for="contact-email">Your email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              placeholder="you@company.com"
              aria-describedby="contact-email-error"
            />
            <p id="contact-email-error" class="contact-error" data-field-error="email"></p>
          </div>
          <div class="contact-field">
            <label for="contact-subject">Subject</label>
            <input
              id="contact-subject"
              name="subject"
              type="text"
              required
              maxlength={CONTACT_LIMITS.subject}
              placeholder="Backend role at …"
              aria-describedby="contact-subject-error"
            />
            <p id="contact-subject-error" class="contact-error" data-field-error="subject"></p>
          </div>
          <div class="contact-field sm:col-span-2">
            <div class="flex items-center justify-between">
              <label for="contact-message">Message</label>
              <span class="tabular text-[0.7rem] text-faint" data-contact-counter aria-hidden="true">0 / {CONTACT_LIMITS.message}</span>
            </div>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              required
              maxlength={CONTACT_LIMITS.message}
              placeholder="What are you building, and how can I help?"
              aria-describedby="contact-message-error"
            ></textarea>
            <p id="contact-message-error" class="contact-error" data-field-error="message"></p>
          </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <p class="contact-status" data-contact-status data-tone="idle" role="status" aria-live="polite"></p>
          <button
            type="submit"
            data-contact-submit
            class="contact-submit inline-flex items-center gap-3 rounded-full bg-accent px-6 py-3 font-medium text-bg transition-all duration-300 hover:shadow-glow disabled:opacity-60"
          >
            <span class="contact-spinner" aria-hidden="true"></span>
            Send message
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </form>

      <aside class="flex flex-col justify-between gap-8 rounded-[1.25rem] border border-line p-6 sm:p-8 lg:col-span-5">
        <div>
          <p class="eyebrow">Prefer email?</p>
          <button
            type="button"
            data-copy={email}
            class="group mt-5 inline-flex max-w-full items-center gap-3 rounded-full bg-elevated px-5 py-3 text-left transition-colors duration-300 hover:bg-accent-soft"
          >
            <span data-copy-label class="truncate">{email}</span>
            <span aria-hidden="true" class="font-mono text-xs text-accent">copy</span>
          </button>
          <a href={`mailto:${email}`} class="link-underline mt-4 block w-fit text-sm text-muted hover:text-text">or open your mail app ↗</a>
        </div>
        <p class="font-mono text-xs leading-relaxed text-faint">
          No database, no tracking. Your message is mailed to me and nowhere else.
        </p>
      </aside>
    </div>

    <ul class="mt-6 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4" data-reveal>
      {
        links.map((link, index) => (
          <li class={fillLastRow(index)}>
            <a href={link.url} target="_blank" rel="noopener" class="group flex h-full items-center justify-between gap-4 bg-bg px-5 py-4 transition-colors duration-300 hover:bg-surface">
              <span>
                <span class="block text-sm">{link.label}</span>
                <span class="font-mono text-xs text-faint">{link.note}</span>
              </span>
              <span aria-hidden="true" class="text-faint transition-all duration-500 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent">↗</span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer class="mt-20 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 font-mono text-xs text-faint">
      <p>© {year} {name}. Built with Astro, served by a free-threaded Python API.</p>
      <p class="flex items-center gap-2" data-api-status>
        <span class="size-1.5 rounded-full bg-faint" data-api-status-dot></span>
        <span data-api-status-label>API status: checking…</span>
      </p>
    </footer>
  </div>
</section>
