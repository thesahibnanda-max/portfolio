---
import type { Personality } from "../../lib/api/schemas";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  readonly personality: Personality;
}

const { personality } = Astro.props;
const profile = personality.personal_profile;
const sports = Object.entries(profile.interests.sports);
const favourites = [
  ...profile.favorites.movies.map((item) => ({ kind: "Film", title: item.title, note: item.genre })),
  ...profile.favorites.games.map((item) => ({ kind: "Game", title: item.title, note: item.genre })),
  ...profile.favorites.artists.map((item) => ({ kind: "Music", title: item.name, note: item.type })),
];
---

<section id="off-the-clock" class="relative px-5 py-28 sm:px-8 md:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader index={7} label="Off the clock" title="When the" emphasis="laptop closes." />

    <div class="grid gap-5 md:grid-cols-12">
      <article class="card p-7 md:col-span-7" data-reveal>
        <p class="eyebrow">On match day</p>
        <ul class="mt-6 grid gap-6 sm:grid-cols-2">
          {
            sports.map(([sport, details]) => (
              <li>
                <p class="font-mono text-xs text-faint capitalize">{sport}</p>
                <p class="display mt-2 text-4xl">{details.favorite_team}</p>
                <p class="mt-1 text-muted">
                  Ride or die for <span class="text-accent">{details.favorite_player}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="card p-7 md:col-span-5" data-reveal style="--reveal-index: 1">
        <p class="eyebrow">Values</p>
        <ul class="mt-6 flex flex-wrap gap-2">
          {profile.personality.personal_values.map((value) => <li class="pill text-text">{value}</li>)}
        </ul>
        <p class="eyebrow mt-8">Training</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {profile.interests.fitness.map((item) => <li class="pill">{item}</li>)}
        </ul>
      </article>
      <article class="card p-7 md:col-span-8" data-reveal>
        <p class="eyebrow">On rotation</p>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {
            favourites.map((item) => (
              <li class="flex items-baseline gap-4 border-t border-line pt-4">
                <span class="w-12 shrink-0 font-mono text-xs text-faint">{item.kind}</span>
                <span>
                  <span class="block text-lg">{item.title}</span>
                  <span class="text-sm text-muted">{item.note}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </article>
      <article class="card p-7 md:col-span-4" data-reveal style="--reveal-index: 1">
        <p class="eyebrow">Speaks</p>
        <ul class="mt-6 grid gap-3">
          {
            profile.languages.map((language) => (
              <li class="flex items-center justify-between border-t border-line pt-3">
                <span>{language.name}</span>
                <span class="font-mono text-xs text-muted">{language.proficiency}</span>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
  </div>
</section>
