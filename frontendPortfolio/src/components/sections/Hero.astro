---
import { Picture } from "astro:assets";
import type { CodeforcesAccount, Experience, LeetcodeAccount } from "../../lib/api/schemas";
import { codeforcesRank, formatGrouped } from "../../lib/format";

interface Props {
  readonly name: string;
  readonly current: Experience | undefined;
  readonly tagline: string | null;
  readonly codeforces: CodeforcesAccount | undefined;
  readonly leetcode: LeetcodeAccount | undefined;
  readonly resumeLink: string;
  readonly profileImageUrl: string;
}

const { name, current, tagline, codeforces, leetcode, resumeLink, profileImageUrl } = Astro.props;
const [firstName, ...rest] = name.split(" ");
const lastName = rest.join(" ");
const peak = codeforces?.max_rating ?? null;
const peakRank = peak === null ? null : codeforcesRank(peak);
---

<section id="top" class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden px-5 pt-28 pb-12 sm:px-8">
  <canvas data-hero-shader class="absolute inset-0 -z-10 size-full" aria-hidden="true"></canvas>
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_70%_20%,rgb(245_165_36/0.18),transparent_55%),radial-gradient(ellipse_at_10%_90%,rgb(245_165_36/0.08),transparent_50%)]"
    data-hero-fallback
  ></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-1/2 bg-gradient-to-b from-transparent to-bg"></div>

  <div class="mx-auto w-full max-w-6xl">
    <div class="grid items-center gap-x-12 gap-y-7 md:grid-cols-[minmax(0,1fr)_auto]">
    <div class="hero-portrait-slot md:order-last" data-reveal>
    <figure class="hero-portrait size-24 sm:size-28 md:size-[clamp(13rem,21vw,17.5rem)]">
      <Picture
        src={profileImageUrl}
        inferSize
        alt={name}
        formats={["avif", "webp"]}
        fallbackFormat="jpg"
        widths={[112, 224, 288, 400]}
        sizes="(min-width: 768px) 17.5rem, (min-width: 640px) 7rem, 6rem"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </figure>
    </div>
    <div class="min-w-0">
    <p class="eyebrow mb-8 flex items-center gap-3" data-reveal>
      <span class="relative flex size-2">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60"></span>
        <span class="relative inline-flex size-2 rounded-full bg-success"></span>
      </span>
      {current === undefined ? "Software engineer" : `${current.title} · ${current.company}`}
    </p>

    <h1 class="display text-[clamp(4.5rem,21vw,6.5rem)] sm:text-[clamp(4rem,12.5vw,11rem)]" data-reveal style="--reveal-index: 1">
      <span class="block">{firstName}</span>
      <span class="block pl-[0.6em] text-accent italic">{lastName}</span>
    </h1>
    </div>
    </div>

    <div class="mt-8 grid gap-10 md:grid-cols-12 md:items-end">
      <p class="max-w-xl text-lg leading-relaxed text-muted md:col-span-6" data-reveal style="--reveal-index: 2">
        Backend engineer building <span class="text-text">distributed, event-driven systems</span> that stay up.
        {tagline !== null && <span class="mt-3 block font-mono text-sm text-faint">“{tagline}”</span>}
      </p>

      <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-line bg-line md:col-span-6" data-reveal style="--reveal-index: 3">
        {
          codeforces !== undefined && peak !== null && peakRank !== null && (
            <div class="bg-bg/80 p-4 backdrop-blur">
              <dt class="eyebrow text-[0.65rem]">CF peak</dt>
              <dd class="tabular mt-2 text-2xl sm:text-3xl" style={`color: ${peakRank.color}`}>
                <span data-count={peak} data-stat={`cf.${codeforces.handle}.max`}>{formatGrouped(peak)}</span>
              </dd>
              <dd class="mt-1 text-xs text-muted">{peakRank.title}</dd>
            </div>
          )
        }
        {
          leetcode !== undefined && leetcode.total_solved !== null && (
            <div class="bg-bg/80 p-4 backdrop-blur">
              <dt class="eyebrow text-[0.65rem]">LeetCode</dt>
              <dd class="tabular mt-2 text-2xl text-text sm:text-3xl">
                <span data-count={leetcode.total_solved} data-stat={`lc.${leetcode.username}.total`}>
                  {formatGrouped(leetcode.total_solved)}
                </span>
              </dd>
              <dd class="mt-1 text-xs text-muted">problems solved</dd>
            </div>
          )
        }
        {
          codeforces !== undefined && (
            <div class="bg-bg/80 p-4 backdrop-blur">
              <dt class="eyebrow text-[0.65rem]">Contests</dt>
              <dd class="tabular mt-2 text-2xl text-text sm:text-3xl">
                <span data-count={codeforces.contests_count} data-stat={`cf.${codeforces.handle}.contests`}>
                  {codeforces.contests_count}
                </span>
              </dd>
              <dd class="mt-1 text-xs text-muted">rated on Codeforces</dd>
            </div>
          )
        }
      </dl>
    </div>

    <div class="mt-10 flex flex-wrap items-center gap-3" data-reveal style="--reveal-index: 4">
      <button
        type="button"
        data-open-chat
        class="group inline-flex items-center gap-3 rounded-full bg-accent px-6 py-3 font-medium text-bg transition-all duration-300 hover:shadow-glow"
      >
        Ask my AI anything
        <kbd class="rounded-full bg-bg/15 px-2 py-0.5 font-mono text-xs">⌘K</kbd>
      </button>
      <a
        href={resumeLink}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-full border border-line-strong px-6 py-3 text-text transition-colors duration-300 hover:border-text"
      >
        Résumé
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">↗</span>
      </a>
      <a href="#experience" class="ml-auto hidden items-center gap-3 font-mono text-xs text-faint md:inline-flex">
        <span class="h-10 w-px bg-gradient-to-b from-transparent via-accent to-transparent"></span>
        scroll
      </a>
    </div>
  </div>
</section>

<script>
  import { startHeroShader } from "../../scripts/heroShader";

  const canvas = document.querySelector<HTMLCanvasElement>("[data-hero-shader]");
  if (canvas !== null) {
    startHeroShader(canvas);
  }
</script>
