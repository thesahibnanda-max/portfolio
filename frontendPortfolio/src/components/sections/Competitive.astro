---
import type { CodeforcesAccount, LeetcodeAccount } from "../../lib/api/schemas";
import { codeforcesRank, formatGrouped } from "../../lib/format";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  readonly codeforces: readonly CodeforcesAccount[];
  readonly leetcode: readonly LeetcodeAccount[];
  readonly codeforcesLinks: readonly string[];
  readonly leetcodeLinks: readonly string[];
}

const { codeforces, leetcode, codeforcesLinks, leetcodeLinks } = Astro.props;
const RING_RADIUS = 52;
const RING_LENGTH = 2 * Math.PI * RING_RADIUS;

function ringSegments(account: LeetcodeAccount) {
  const parts = [
    { label: "Easy", value: account.easy_solved ?? 0, color: "#4ADE80" },
    { label: "Medium", value: account.medium_solved ?? 0, color: "#F5A524" },
    { label: "Hard", value: account.hard_solved ?? 0, color: "#F87171" },
  ];
  const total = parts.reduce((sum, part) => sum + part.value, 0);
  let offset = 0;
  return parts.map((part) => {
    const length = total === 0 ? 0 : (part.value / total) * RING_LENGTH;
    const segment = { ...part, dash: `${Math.max(0, length - 3)} ${RING_LENGTH}`, offset: -offset };
    offset += length;
    return segment;
  });
}

function topTags(account: LeetcodeAccount): readonly [string, number][] {
  return Object.entries({ ...account.advanced_tags_solved, ...account.intermediate_tags_solved })
    .sort((left, right) => right[1] - left[1])
    .slice(0, 6);
}
---

<section id="competitive" class="relative px-5 py-28 sm:px-8 md:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader
      index={3}
      label="Competitive programming"
      title="Algorithms,"
      emphasis="under a clock."
      lede="Contest ratings and problem counts, refreshed live from Codeforces and LeetCode."
    />

    <div class="grid gap-5 lg:grid-cols-12">
      {
        codeforces.map((account, index) => {
          const current = account.current_rating === null ? null : codeforcesRank(account.current_rating);
          const peak = account.max_rating === null ? null : codeforcesRank(account.max_rating);
          const history = account.rating_history.filter((change) => change.contest_time !== null);
          const series = JSON.stringify(
            history.map((change) => [Date.parse(change.contest_time ?? "") / 1000, change.new_rating]),
          );
          const recent = [...account.rating_history].reverse().slice(0, 4);
          return (
            <article class="card overflow-hidden p-6 sm:p-8 lg:col-span-7" data-reveal>
              <header class="flex flex-wrap items-start justify-between gap-4">
                <div>
                  <p class="eyebrow">Codeforces</p>
                  <a
                    href={codeforcesLinks[index] ?? `https://codeforces.com/profile/${account.handle}`}
                    target="_blank"
                    rel="noopener"
                    class="link-underline mt-2 inline-block font-mono text-sm text-muted"
                  >
                    @{account.handle}
                  </a>
                </div>
                <dl class="flex gap-8 text-right">
                  <div>
                    <dt class="eyebrow text-[0.65rem]">Rating</dt>
                    <dd class="tabular mt-1 text-4xl" style={current === null ? undefined : `color: ${current.color}`}>
                      {account.current_rating !== null && (
                        <span data-count={account.current_rating} data-stat={`cf.${account.handle}.current`}>
                          {formatGrouped(account.current_rating)}
                        </span>
                      )}
                    </dd>
                    <dd class="text-xs text-muted">{current?.title ?? "Unrated"}</dd>
                  </div>
                  <div>
                    <dt class="eyebrow text-[0.65rem]">Peak</dt>
                    <dd class="tabular mt-1 text-4xl" style={peak === null ? undefined : `color: ${peak.color}`}>
                      {account.max_rating !== null && (
                        <span data-count={account.max_rating} data-stat={`cf.${account.handle}.max`}>
                          {formatGrouped(account.max_rating)}
                        </span>
                      )}
                    </dd>
                    <dd class="text-xs text-muted">{peak?.title ?? "Unrated"}</dd>
                  </div>
                </dl>
              </header>
              <div class="mt-8 h-56 w-full" data-rating-chart={series} role="img" aria-label={`Codeforces rating history for ${account.handle}`}></div>
              <ul class="mt-6 grid gap-2">
                {recent.map((change) => {
                  const delta = change.new_rating - change.old_rating;
                  return (
                    <li class="flex items-center justify-between gap-4 border-t border-line pt-2 text-sm">
                      <span class="truncate text-muted">{change.contest_name}</span>
                      <span class:list={["tabular shrink-0", delta >= 0 ? "text-success" : "text-danger"]}>
                        {delta >= 0 ? "+" : ""}
                        {delta}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </article>
          );
        })
      }

      {
        leetcode.map((account, index) => (
          <article class="card p-6 sm:p-8 lg:col-span-5" data-reveal style="--reveal-index: 1">
            <header>
              <p class="eyebrow">LeetCode</p>
              <a
                href={leetcodeLinks[index] ?? `https://leetcode.com/u/${account.username}/`}
                target="_blank"
                rel="noopener"
                class="link-underline mt-2 inline-block font-mono text-sm text-muted"
              >
                @{account.username}
              </a>
            </header>
            <div class="mt-8 flex items-center gap-8">
              <svg viewBox="0 0 120 120" class="size-36 shrink-0 -rotate-90" aria-hidden="true">
                <circle cx="60" cy="60" r={RING_RADIUS} fill="none" stroke="rgb(255 255 255 / 0.06)" stroke-width="8" />
                {ringSegments(account).map((segment) => (
                  <circle
                    cx="60"
                    cy="60"
                    r={RING_RADIUS}
                    fill="none"
                    stroke={segment.color}
                    stroke-width="8"
                    stroke-linecap="round"
                    stroke-dasharray={segment.dash}
                    stroke-dashoffset={segment.offset}
                  />
                ))}
              </svg>
              <div>
                <p class="tabular text-5xl">
                  {account.total_solved !== null && (
                    <span data-count={account.total_solved} data-stat={`lc.${account.username}.total`}>
                      {formatGrouped(account.total_solved)}
                    </span>
                  )}
                </p>
                <p class="text-sm text-muted">problems solved</p>
                <dl class="mt-4 grid gap-1 font-mono text-xs">
                  {ringSegments(account).map((segment) => (
                    <div class="flex items-center gap-2">
                      <span class="size-2 rounded-full" style={`background: ${segment.color}`} aria-hidden="true" />
                      <dt class="w-14 text-muted">{segment.label}</dt>
                      <dd class="tabular" data-stat={`lc.${account.username}.${segment.label.toLowerCase()}`}>{segment.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            </div>
            <dl class="mt-8 grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-line bg-line text-center">
              <div class="bg-surface p-3">
                <dt class="eyebrow text-[0.6rem]">Contest</dt>
                <dd class="tabular mt-1 text-lg">{account.contest_rating === null ? "—" : Math.round(account.contest_rating)}</dd>
              </div>
              <div class="bg-surface p-3">
                <dt class="eyebrow text-[0.6rem]">Streak</dt>
                <dd class="tabular mt-1 text-lg">{account.current_streak ?? "—"}d</dd>
              </div>
              <div class="bg-surface p-3">
                <dt class="eyebrow text-[0.6rem]">Active</dt>
                <dd class="tabular mt-1 text-lg">{account.total_active_days ?? "—"}d</dd>
              </div>
            </dl>
            <p class="eyebrow mt-8 text-[0.65rem]">Strongest topics</p>
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {topTags(account).map(([tag, count]) => (
                <li class="pill">
                  {tag}
                  <span class="text-accent">{count}</span>
                </li>
              ))}
            </ul>
            {account.badges.length > 0 && (
              <>
                <p class="eyebrow mt-6 text-[0.65rem]">Badges</p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {account.badges.map((badge) => (
                    <li class="pill border-accent/25 text-accent/90">{badge}</li>
                  ))}
                </ul>
              </>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { mountRatingCharts } from "../../scripts/ratingChart";

  mountRatingCharts();
</script>
