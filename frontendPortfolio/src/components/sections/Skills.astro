---
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  readonly skillsByCategory: Readonly<Record<string, readonly string[]>>;
}

const { skillsByCategory } = Astro.props;
const categories = Object.entries(skillsByCategory);
---

<section id="skills" class="relative px-5 py-28 sm:px-8 md:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader
      index={5}
      label="Toolbox"
      title="The stack,"
      emphasis="by category."
      lede="Hover a skill to light up every role and project that used it."
    />

    <dl class="grid overflow-hidden rounded-2xl border border-line sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map(([category, skills], index) => (
          <div class="p-6 outline outline-1 outline-line transition-colors duration-500 hover:bg-surface" data-reveal style={`--reveal-index: ${index % 3}`}>
            <dt class="eyebrow flex items-center justify-between">
              {category}
              <span class="tabular text-faint">{String(skills.length).padStart(2, "0")}</span>
            </dt>
            <dd class="mt-4">
              <ul class="flex flex-wrap gap-1.5">
                {skills.map((skill) => (
                  <li>
                    <button type="button" class="pill cursor-default" data-skill={skill.toLowerCase()}>
                      {skill}
                    </button>
                  </li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<script>
  import { startSkillHighlights } from "../../scripts/skills";

  startSkillHighlights();
</script>
