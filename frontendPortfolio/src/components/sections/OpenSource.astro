---
import type { GitHubAccount } from "../../lib/api/schemas";
import SectionHeader from "../ui/SectionHeader.astro";

interface Props {
  readonly accounts: readonly GitHubAccount[];
}

const { accounts } = Astro.props;
const TOP_REPOS = 6;

function topRepositories(account: GitHubAccount) {
  return [...account.repositories]
    .filter((repo) => repo.description !== null)
    .sort((left, right) => right.stars - left.stars || Date.parse(right.updated_at) - Date.parse(left.updated_at))
    .slice(0, TOP_REPOS);
}
---

<section id="open-source" class="relative px-5 py-28 sm:px-8 md:py-40">
  <div class="mx-auto max-w-6xl">
    <SectionHeader index={4} label="Open source" title="Code in" emphasis="the open." />

    <div class="grid gap-5 lg:grid-cols-2">
      {
        accounts.map((account, index) => (
          <article class="card overflow-hidden" data-reveal style={`--reveal-index: ${index}`}>
            <header class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-line px-6 py-4">
              <div class="hidden items-center gap-2 sm:flex" aria-hidden="true">
                <span class="size-2.5 rounded-full bg-white/10"></span>
                <span class="size-2.5 rounded-full bg-white/10"></span>
                <span class="size-2.5 rounded-full bg-white/10"></span>
              </div>
              <a href={account.html_url} target="_blank" rel="noopener" class="link-underline min-w-0 truncate font-mono text-xs text-muted">
                ~/github/{account.username}
              </a>
              <dl class="flex gap-4 font-mono text-xs text-faint">
                <div class="flex gap-1">
                  <dt>repos</dt>
                  <dd class="text-text" data-stat={`gh.${account.username}.repos`}>{account.public_repos}</dd>
                </div>
                <div class="flex gap-1">
                  <dt>followers</dt>
                  <dd class="text-text" data-stat={`gh.${account.username}.followers`}>{account.followers}</dd>
                </div>
              </dl>
            </header>
            <ul class="divide-y divide-line">
              {topRepositories(account).map((repo) => (
                <li>
                  <a href={repo.html_url} target="_blank" rel="noopener" class="group flex gap-4 px-6 py-4 transition-colors duration-300 hover:bg-white/[0.02]">
                    <span class="mt-0.5 font-mono text-accent" aria-hidden="true">›</span>
                    <span class="min-w-0 flex-1">
                      <span class="flex items-center justify-between gap-4">
                        <span class="truncate font-mono text-sm text-text group-hover:text-accent">{repo.name}</span>
                        <span class="flex shrink-0 items-center gap-3 font-mono text-xs text-faint">
                          {repo.language !== null && <span>{repo.language}</span>}
                          <span>★ {repo.stars}</span>
                        </span>
                      </span>
                      <span class="mt-1 line-clamp-2 block text-sm text-muted">{repo.description}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
