---
interface Props {
  readonly initials: string;
  readonly links: readonly { readonly href: string; readonly label: string }[];
}

const { initials, links } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50">
  <nav
    aria-label="Primary"
    class="mx-3 mt-3 flex max-w-6xl sm:mx-auto sm:mt-4 items-center justify-between gap-4 rounded-full border border-line bg-bg/60 px-3 py-2 backdrop-blur-xl sm:px-4"
  >
    <a href="#top" class="flex items-center gap-2 rounded-full px-2 py-1" aria-label={`${initials}, back to top`}>
      <span class="grid size-8 place-items-center rounded-full bg-accent font-mono text-xs font-semibold text-bg">
        {initials}
      </span>
    </a>
    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="rounded-full px-3 py-1.5 text-sm text-muted transition-colors duration-200 hover:bg-white/5 hover:text-text"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button
      type="button"
      data-open-chat
      class="group flex items-center gap-2 rounded-full border border-accent/30 bg-accent-soft py-1.5 pr-1.5 pl-3 text-sm text-accent transition-all duration-300 hover:border-accent/60 hover:shadow-glow"
    >
      <span class="size-1.5 animate-pulse rounded-full bg-accent"></span>
      Ask my AI
      <kbd class="rounded-full border border-accent/30 px-2 py-0.5 font-mono text-[0.65rem]">⌘K</kbd>
    </button>
  </nav>
</header>
